# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (copy this file to ".env" and fill in your real values)

# ---------- เวอร์ชันซอฟต์แวร์ (ควรระบุเลขจริงแทน latest เพื่อให้ติดตั้งซ้ำแล้วได้ผลเหมือนเดิม) ----------
# ดูเวอร์ชันที่รันอยู่: docker exec tax-advisor-n8n n8n --version
#                     docker exec tax-advisor-postgres postgres --version
# ห้ามเปลี่ยนเวอร์ชันหลักของ PostgreSQL (เช่น 16 -> 17) หลังมีข้อมูลแล้ว ต้อง dump/restore ก่อน
POSTGRES_VERSION=16-alpine
N8N_VERSION=latest

# ---------- PostgreSQL ----------
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=n8n
APP_DB_NAME=tax_advisor
POSTGRES_PORT=5432

# ---------- n8n ----------
N8N_PORT=5678
N8N_HOST=localhost
# ใส่ localhost ไปก่อน ได้ ngrok URL แล้วค่อยเปลี่ยน
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Bangkok

# n8n v1+ ไม่ใช้ N8N_BASIC_AUTH_USER/PASSWORD แล้ว บัญชีผู้ดูแลสร้างตอนเปิดหน้าเว็บครั้งแรก

# ใช้เข้ารหัส credentials ใน n8n ตั้งครั้งเดียวแล้วห้ามเปลี่ยน สร้างด้วย: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_this_to_a_random_32_char_hex_string

# ---------- pgAdmin (เว็บดูฐานข้อมูล เปิดเมื่อต้องการ) ----------
# เปิด: docker compose --profile tools up -d pgadmin แล้วเข้า http://localhost:5050 ด้วยอีเมล/รหัสผ่านด้านล่าง
PGADMIN_EMAIL=admin@taxadvisor.local
PGADMIN_PASSWORD=admin1234
PGADMIN_PORT=5050

# ---------- ngrok (tunnel ให้ LINE เรียก webhook ของ n8n ในเครื่องได้) ----------
# สมัครฟรีที่ https://dashboard.ngrok.com/signup แล้วนำ authtoken มาใส่
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ---------- LINE Official Account / Messaging API ----------
# ดูได้จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ---------- แบบจำลองภาษา (ตั้งได้หลายตัวเพื่อเปรียบเทียบกัน) ----------

# 1) OpenAI (มีค่าใช้จ่าย) ขอคีย์ที่ https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2) Google Gemini (มีโควตาฟรี) ขอคีย์ที่ https://aistudio.google.com/apikey
#    โควตาฟรีต่างกันมากในแต่ละรุ่น ดูก่อนเลือก: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ชื่อโมเดลที่ใช้อยู่จริง บันทึกลง conversations เพื่อแยกวิเคราะห์ผลตามโมเดล
# สลับโมเดลแล้วต้องแก้ค่านี้ และรัน docker compose up -d --force-recreate n8n
ACTIVE_MODEL_NAME=gemini-3-flash-preview

# 3) Typhoon (โมเดลภาษาไทยของ SCB 10X) รันในเครื่องผ่าน Ollama ฟรี ดูเพิ่มที่ n8n/ollama/README.md
#    ติดตั้ง Ollama จาก https://ollama.com/download แล้วรัน: ollama pull scb10x/typhoon2.5-qwen3-4b
#    ค่าด้านล่างใช้กับสคริปต์ใน evaluation/ ที่รันบนเครื่อง ส่วน n8n ใน container ใช้ http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
TYPHOON_MODEL=scb10x/typhoon2.5-qwen3-4b

# ---------- รหัส credential ของ n8n (ไม่ใส่ก็ได้) ----------
# ใส่แล้ว n8n/build-workflow.py จะฝังให้อัตโนมัติ ไม่ต้องผูก credential เองทุกโหนดหลังนำเข้า
# รหัสอยู่ท้าย URL ของ credential ใน n8n เช่น http://localhost:5678/home/credentials/AbCdEf123456 รหัสคือ AbCdEf123456
N8N_PG_CREDENTIAL_ID=
N8N_PG_CREDENTIAL_NAME=Tax Advisor Postgres
N8N_LLM_CREDENTIAL_ID=
N8N_LLM_CREDENTIAL_NAME=Google Gemini (Tax Advisor)

# ---------- หน้าเว็บหลังบ้าน (http://localhost:8080) ----------
# ดูสถิติและจัดการฐานความรู้ได้ แต่อ่านประวัติแชทไม่ได้ (บังคับที่สิทธิ์ฐานข้อมูล)

# รหัสผ่านเข้าหน้าหลังบ้าน ตั้งให้ยาวและเดายาก
ADMIN_PASSWORD=ตั้งรหัสผ่านของผู้ดูแลเอง

# รหัสผ่านบัญชีฐานข้อมูล tax_admin_readonly ต้องตรงกับที่ตั้งหลังรัน migration 005 ด้วย
#   ALTER ROLE tax_admin_readonly PASSWORD 'ค่าเดียวกับบรรทัดนี้';
ADMIN_DB_PASSWORD=ตั้งรหัสผ่านฐานข้อมูลของผู้ดูแลเอง

# พอร์ตหน้าหลังบ้าน ผูกกับ 127.0.0.1 เท่านั้น ไม่เปิดออกอินเทอร์เน็ต
ADMIN_WEB_PORT=8080
